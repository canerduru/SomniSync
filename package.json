  "main": "expo-router/entry",
  "version": "0.1.0",
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "expo": "~57.0.27",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "i18next": "^25.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^16.0.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "~19.2.2",
    "astronomy-engine": "2.1.19",
    "music-metadata": "12.1.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > src/types/database.ts",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write app src tests supabase/functions app.config.ts",
    "format:check": "prettier --check app src tests supabase/functions app.config.ts",
    "test:backend": "node tests/backend.integration.mjs",
    "functions:serve": "supabase functions serve dreams-api --no-verify-jwt",
    "functions:check": "deno check --no-config --node-modules-dir=none --no-lock supabase/functions/dreams-api/index.ts",
    "functions:serve:ai": "supabase functions serve dreams-api --no-verify-jwt --env-file supabase/.env.secrets",
    "test:ai": "deno test --no-config --node-modules-dir=none --no-lock --allow-env supabase/functions/_shared/ai/pipeline.test.ts",
    "typecheck:edge": "tsc -p tsconfig.edge.json"
  },
  "private": true
}
