# Public client settings only. AI keys belong exclusively in Edge Function secrets.
# demo = in-memory fixtures; supabase = authenticated persistent account.
EXPO_PUBLIC_DATA_MODE=supabase
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
# Use the local anon key from `supabase status`; a hosted publishable key also works.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
